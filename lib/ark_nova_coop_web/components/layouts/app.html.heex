<header class="bg-gray-800 text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-4">
      <div class="flex items-center gap-4">
        <a href="/" class="text-xl font-bold hover:text-gray-300">
          Ark Nova Cooperative Tracker
        </a>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <a
          href="https://boardgamegeek.com/thread/3174549/ark-nova-full-cooperative-variant-with-endgame-goa"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-gray-300"
        >
          Inspired by BGG Cooperative Rules
        </a>
      </div>
    </div>
  </div>
</header>
<main>
  <.flash_group flash={@flash} />
  {@inner_content}
</main>
